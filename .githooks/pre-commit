#!/usr/bin/env bash
set -euo pipefail

before="$(mktemp)"
after="$(mktemp)"
trap 'rm -f "$before" "$after"' EXIT

git diff --binary >"$before"
nix fmt .
git diff --binary >"$after"

if ! cmp -s "$before" "$after"; then
  echo "nix fmt changed files. Review and stage the formatting changes, then commit again." >&2
  exit 1
fi
